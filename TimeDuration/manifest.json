{
  "manifest_version": 3,
  "name": "GCal Time Duration",
  "version": "1.0",
  "description": "Pokazuje czas trwania wydarzeń w Google Calendar i podlicza łączny czas wybranych elementów.",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Time Duration — ustawienia"
  },
  "content_scripts": [
    {
      "matches": ["*://calendar.google.com/*"],
      "css": ["styles.css"],
      "js": ["content.js"]
    }
  ]
}
